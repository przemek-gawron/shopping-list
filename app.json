{
  "expo": {
    "name": "Dishdeck",
    "slug": "shopping-list",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dishdeck",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.przemekgawron.dishdeck",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Aplikacja potrzebuje dostępu do zdjęć, aby dodać zdjęcie do przepisu.",
        "NSCameraUsageDescription": "Aplikacja potrzebuje aparatu, aby zrobić zdjęcie do przepisu."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#047857",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.przemekgawron.dishdeck"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 220,
          "backgroundColor": "#047857"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikacja potrzebuje dostępu do zdjęć, aby dodać zdjęcie do przepisu.",
          "cameraPermission": "Aplikacja potrzebuje aparatu, aby zrobić zdjęcie do przepisu.",
          "microphonePermission": false
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5026f73-6696-4235-82c6-5c7a04ff3587"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "przemek-gawron-dev",
    "updates": {
      "url": "https://u.expo.dev/f5026f73-6696-4235-82c6-5c7a04ff3587"
    }
  }
}
