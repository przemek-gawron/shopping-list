# URL of the Express proxy (no trailing slash). On a physical device use your machine's LAN IP, e.g. http://192.168.1.10:3000
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# Google Sign-In (native + web) — from Google Cloud Console
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Facebook app id (client id for expo-auth-session)
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Backwards compatibility: a shared app token is no longer used. Use /api/auth/* and JWTs instead.

# Remove EXPO_PUBLIC_ANTHROPIC_API_KEY if present — the Anthropic key belongs only in backend/.env
