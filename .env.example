# URL of the Express proxy (no trailing slash). On a physical device use your machine's LAN IP, e.g. http://192.168.1.10:3000
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# Optional: must match backend CLIENT_TOKEN when set
EXPO_PUBLIC_BACKEND_TOKEN=

# Remove EXPO_PUBLIC_ANTHROPIC_API_KEY if present — the Anthropic key belongs only in backend/.env
