# Anthropic (server-side only — never put this in the Expo app)
ANTHROPIC_API_KEY=

# Optional: require clients to send Authorization: Bearer <same value>
# If unset, any client can call the API (fine for local dev only).
CLIENT_TOKEN=

PORT=3000

# Comma-separated origins for CORS, or * for all (dev only)
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
