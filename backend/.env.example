# Anthropic (server-side only)
ANTHROPIC_API_KEY=

# Auth — long random string used to sign JWTs. Required for /api/auth/* and all protected /api/* routes.
# Create one with: openssl rand -hex 32
JWT_SECRET=

# SQLite database file (default: ./data/app.db)
# DB_PATH=

# Google: OAuth client IDs whose ID tokens the server will accept (comma-separated)
# Include Web + iOS + Android client IDs as created in Google Cloud Console
GOOGLE_CLIENT_IDS=

# Apple Sign in: the Services ID (web) or iOS app bundle id used as the token `aud`
# Must match the client that obtained the `identityToken` (e.g. com.yourapp.bundle)
APPLE_CLIENT_ID=

# Facebook: app + secret for the Graph debug_token and /me calls
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

PORT=3000

# Comma-separated origins for CORS, or * for all (dev only)
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
